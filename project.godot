;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DynaBlaster"
run/main_scene="uid://ce5dqtsvlo10v"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GlobalVar="*uid://51ekvpyox8ih"
GlobalFunc="*uid://ddmwcgvhwhjam"

[display]

window/stretch/scale_mode="integer"

[editor]

movie_writer/video_quality=0.5
movie_writer/ogv/encoding_speed=1
movie_writer/ogv/keyframe_interval=63
movie_writer/movie_file="C:/prog/projects/dynablast/o.avi"
movie_writer/fps=30

